NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Recommended production database: MongoDB Atlas. Local development starts a
# real MongoDB process with persistent files in .data/mongo when URI is empty.
MONGODB_URI=
# Free local Ollama inference on the server computer. No paid AI/API keys.
LOCAL_AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
OLLAMA_TEXT_MODEL=qwen3-vl:2b-instruct
# The local launcher also sets OLLAMA_NO_CLOUD=1 for the Ollama process.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Production can explicitly use private local uploads on a persistent volume.
# Mount that volume at /app/.data/uploads when running the Docker image.
LOCAL_UPLOADS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FitTrack AI <hello@example.com>
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Optional public backend origin compiled into the mobile app. This is NOT a secret.
# Leave empty to use the app's connection screen. Rebuild/sync after changing it.
VITE_API_URL=
